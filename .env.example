# Copy this file to .env and fill in the values. Never commit .env.

# production enables Secure cookies (required behind HTTPS)
NODE_ENV=production

# Bind address. Use 127.0.0.1 when a reverse proxy runs on the same machine.
HOST=0.0.0.0
PORT=3000

# Signing secret for admin sessions.
# Recommended: paste a 96-char hex value from: openssl rand -hex 48
# Leave empty to generate data/.secret automatically.
SAS_SECRET=

# Where db.json, uploads/ and .secret live.
# Docker Compose overrides this to /app/data.
SAS_DATA_DIR=./data
